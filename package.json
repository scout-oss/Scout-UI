{
  "name": "scout-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The open-source sticker UI library.",
  "engines": {
    "node": "24.x",
    "pnpm": "11.21.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "turbo run test",
    "test:browser": "turbo run test:browser",
    "test:fixtures": "node tooling/fixtures/test-packed-consumers.mjs",
    "test:visual": "turbo run test:visual",
    "lint:assets": "turbo run lint:assets",
    "typecheck": "turbo run typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "changeset": "changeset",
    "release": "turbo run build && changeset publish"
  },
  "keywords": [
    "scout-ui",
    "react",
    "design-system",
    "component-library"
  ],
  "license": "MIT",
  "packageManager": "pnpm@11.21.0",
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@changesets/cli": "2.31.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.10",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.9.0",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rollup": "4.62.4",
    "rollup-plugin-esbuild": "6.2.1",
    "sharp": "0.35.3",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "turbo": "2.10.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vitest": "4.1.10"
  }
}
