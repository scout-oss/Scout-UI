{
  "name": "@scout-ui/react",
  "version": "0.0.0",
  "private": true,
  "description": "React components for sticker-led interfaces.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sticker": {
      "types": "./dist/sticker/index.d.ts",
      "import": "./dist/sticker/index.js"
    },
    "./sticker-trail": {
      "types": "./dist/sticker-trail/index.d.ts",
      "import": "./dist/sticker-trail/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rollup --config rollup.config.mjs && tsc --project tsconfig.json --emitDeclarationOnly --pretty false && node ../../tooling/rollup/copy-static.mjs src/styles.css dist/styles.css",
    "dev": "rollup --config rollup.config.mjs --watch",
    "lint": "eslint src tests rollup.config.mjs && stylelint \"src/**/*.css\" --allow-empty-input",
    "test": "vitest run --coverage --config ../../vitest.config.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "@scout-ui/sticker-trail": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
