{
  "name": "@scout-ui/react",
  "version": "0.0.0",
  "private": true,
  "description": "React components for sticker-led interfaces.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sticker": {
      "types": "./dist/sticker/index.d.ts",
      "import": "./dist/sticker/index.js"
    },
    "./sticker-badge": {
      "types": "./dist/sticker-badge/index.d.ts",
      "import": "./dist/sticker-badge/index.js"
    },
    "./sticker-button": {
      "types": "./dist/sticker-button/index.d.ts",
      "import": "./dist/sticker-button/index.js"
    },
    "./sticker-trail": {
      "types": "./dist/sticker-trail/index.d.ts",
      "import": "./dist/sticker-trail/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm tokens:check && rollup --config rollup.config.mjs && tsc --project tsconfig.json --emitDeclarationOnly --pretty false && node ../../tooling/rollup/compose-stylesheet.mjs src/styles.css dist/styles.css ../sticker-trail/src/styles.css",
    "dev": "rollup --config rollup.config.mjs --watch",
    "lint": "pnpm tokens:check && eslint src tests rollup.config.mjs && stylelint \"src/**/*.css\" --allow-empty-input",
    "test": "pnpm tokens:check && vitest run --coverage --config ../../vitest.config.ts",
    "tokens:check": "node ../../tooling/tokens/generate-token-metadata.mjs --check",
    "tokens:generate": "node ../../tooling/tokens/generate-token-metadata.mjs --write",
    "typecheck": "tsc --project tsconfig.json --noEmit --pretty false && tsc --project tsconfig.type-tests.json --pretty false"
  },
  "dependencies": {
    "@scout-ui/sticker-trail": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
