{
  "name": "@scout-ui/stickers",
  "version": "0.1.0",
  "description": "Framework-neutral sticker assets, metadata, and definitions.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scout-oss/Scout-UI.git",
    "directory": "packages/stickers"
  },
  "homepage": "https://design.scoutapp.in/",
  "bugs": {
    "url": "https://github.com/scout-oss/Scout-UI/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "sideEffects": false,
  "files": [
    "assets",
    "dist",
    "ART_DIRECTION.md",
    "ATTRIBUTION.md",
    "CONTRIBUTING_ASSETS.md",
    "LICENSE-ASSETS.md",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    },
    "./manifest.json": "./assets/manifest.json",
    "./definitions/*": {
      "types": "./dist/definitions/*.d.ts",
      "import": "./dist/definitions/*.js"
    },
    "./assets/*.svg": "./assets/*.svg",
    "./package.json": "./package.json"
  },
  "scripts": {
    "assets:check": "node scripts/asset-pipeline.mjs --check",
    "assets:generate": "node scripts/asset-pipeline.mjs --write",
    "build": "pnpm assets:check && rollup --config rollup.config.mjs && tsc --project tsconfig.json --emitDeclarationOnly --composite false --incremental false --pretty false && node ../../tooling/rollup/embed-declaration-sources.mjs dist",
    "dev": "rollup --config rollup.config.mjs --watch",
    "lint": "pnpm assets:check && eslint src tests scripts rollup.config.mjs && stylelint \"src/**/*.css\" --allow-empty-input",
    "lint:assets": "pnpm assets:check",
    "test": "pnpm assets:check && node scripts/test-asset-validation.mjs && vitest run --coverage --config ../../vitest.config.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit --pretty false"
  }
}
