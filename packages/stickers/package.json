{
  "name": "@scout-ui/stickers",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-neutral sticker assets, metadata, and definitions.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "assets",
    "dist",
    "ATTRIBUTION.md",
    "LICENSE-ASSETS.md",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rollup --config rollup.config.mjs && tsc --project tsconfig.json --emitDeclarationOnly --pretty false",
    "dev": "rollup --config rollup.config.mjs --watch",
    "lint": "eslint src tests rollup.config.mjs && stylelint \"src/**/*.css\" --allow-empty-input",
    "test": "vitest run --coverage --config ../../vitest.config.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit --pretty false"
  }
}
